# Generated by `make env` (scripts/gen-local-env.sh) with random values. Local only.
SESSION_SECRET=replace-with-output-of-make-env
API_KEY_PEPPER=replace-with-output-of-make-env
LOCAL_MASTER_KEY=replace-with-output-of-make-env
SANDBOX_SECRET=replace-with-output-of-make-env
TESTFORGE_DEMO_PASSWORD=replace-with-output-of-make-env

# Optional overrides
# TESTFORGE_LOG_LEVEL=INFO
# TESTFORGE_WORKER_CONCURRENCY=4      (jobs one worker handles at once)
# TESTFORGE_GITHUB_API_URL=https://api.github.com   (real GitHub instead of the demo's mock)
# TESTFORGE_APT_MIRROR=http://ftp.de.debian.org/debian   (faster image builds on slow routes)
# TESTFORGE_WEB_PORT=5610
# TESTFORGE_API_PORT=5630
# TESTFORGE_SANDBOX_PORT=5635   (the integration suite's sandbox, make test-integration)
# TESTFORGE_MAILPIT_PORT=5625
# TESTFORGE_MOCKAI_PORT=5650
# TESTFORGE_PG_PORT=5642
# TESTFORGE_REDIS_PORT=5679
# TESTFORGE_FLOCI_PORT=5666
